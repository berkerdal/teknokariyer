# TeknoKariyer sunucu ayarları (docker compose --env-file sunucu.env). Bu örneği sunucu.env adıyla kopyalayıp doldurun.
# sunucu.env depoya girmez. Gizli değerleri güçlü ve rastgele üretin: openssl rand -base64 32

# test: e-postalar dışarı gitmez, test posta kutusuna yazılır. yayin: gerçek gönderim.
ORTAM=test
# Sitenin dışarıdan görünen adresi (sonunda / olmadan). E-posta bağlantıları, site haritası ve kanonik adresler bunu kullanır.
SITE_ADRESI=https://kariyer.pauteknokent.com.tr

# Cloudflare'den taşınırken AYNI değer verilmeli: doğrulayıcı uygulama anahtarları ve bekleyen girişler bununla şifrelidir.
# Değişirse açık oturumlar kapanır, doğrulayıcı uygulama kuranlar uygulamayı yeniden kurmak zorunda kalır.
PAYLOAD_SECRET=

POSTGRES_DB=teknokariyer
POSTGRES_USER=teknokariyer
POSTGRES_PASSWORD=

S3_BUCKET=teknokariyer-dosyalar
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Yayında zorunlu (Cloudflare panelinde Turnstile aracından). Boşsa yayında kayıt ve giriş formları reddedilir.
TURNSTILE_SITE_ANAHTARI=
TURNSTILE_GIZLI_ANAHTAR=

EPOSTA_GONDEREN=kariyer@pauteknokent.com.tr
UYGULAMA_PORTU=3000
